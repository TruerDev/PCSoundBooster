<Window x:Class="PCSoundBooster.BoosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCSoundBooster" Width="370" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        Foreground="#F7F5FF" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#BDB5CF" />
        <SolidColorBrush x:Key="Accent" Color="#B4A4FF" />
        <Style TargetType="ButtonBase" x:Key="PanelButton">
            <Setter Property="Background" Value="#322847" />
            <Setter Property="Foreground" Value="#F7F5FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#493B65" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#5B487A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PanelButton}" />
        <Style x:Key="SliderLane" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                    Height="5" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderLane}"
                                              Background="{StaticResource Accent}"
                                              Command="{x:Static Slider.DecreaseLarge}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Ellipse x:Name="Dot" Width="16" Height="16"
                                                         Fill="{StaticResource Accent}" Stroke="#DBD2FF"
                                                         StrokeThickness="1" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="#E0D8FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderLane}" Background="#4B3D62"
                                              Command="{x:Static Slider.IncreaseLarge}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F7F5FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="{TemplateBinding Background}" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="Pill" Grid.Column="1" Width="38" Height="20" CornerRadius="10"
                                    VerticalAlignment="Center" Background="#4B3D62">
                                <Ellipse x:Name="Knob" Fill="#EFE9FF" Width="14" Height="14"
                                         HorizontalAlignment="Left" Margin="3" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="#231B36" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Panel" Margin="10" Padding="16" CornerRadius="20" BorderThickness="1"
            BorderBrush="#514463">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelMotion" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#120E1D" BlurRadius="18" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2B2240" Offset="0" />
                <GradientStop Color="#1D172B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11"
                        Background="{StaticResource Accent}" Margin="0,0,10,0">
                    <Path Data="M 2,7 V 13 M 8,2 V 18 M 14,5 V 15" Stroke="#251B48"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Right"
                              Width="34" Height="34" Padding="0" Background="#352A47"
                              Style="{StaticResource PanelButton}" ToolTip="Настройки"
                              AutomationProperties.Name="Настройки">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE713;" />
                </ToggleButton>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PCSoundBooster" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Системный звук" FontSize="12" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <Border Background="#322744" BorderBrush="#483958" BorderThickness="1"
                    CornerRadius="13" Padding="12,9,12,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="PercentText" DockPanel.Dock="Left" FontSize="40"
                                   FontWeight="SemiBold" Foreground="#FCF9FF" />
                        <Border Background="#453660" CornerRadius="7" Padding="8,4"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="DecibelText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E4DAFF" />
                        </Border>
                    </DockPanel>
                    <Slider x:Name="Gain" Height="25" Minimum="100" Maximum="500" Value="150"
                            TickFrequency="5" SmallChange="5" LargeChange="25"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            AutomationProperties.Name="Уровень усиления в процентах" />
                    <DockPanel Margin="1,2,1,8" TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="11">
                        <TextBlock DockPanel.Dock="Left" Text="100%" />
                        <TextBlock HorizontalAlignment="Right" Text="500%" />
                    </DockPanel>
                    <Border Height="1" Background="#4B3C5E" Margin="0,0,0,7" />
                    <CheckBox x:Name="Enabled" Style="{StaticResource Switch}" Content="Усиление" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" Margin="1,9,1,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel x:Name="SetupActions" Margin="0,9,0,0" Visibility="Collapsed">
                <Button x:Name="ConnectButton" Content="Подключить Equalizer APO" Margin="0,0,6,0" />
                <Button x:Name="InstallButton" Content="Установить аудиодвижок" Margin="0,0,6,0" />
                <Button x:Name="RefreshButton" Content="Проверить" />
            </WrapPanel>
            <Border x:Name="SettingsPanel" Background="#2A2239" CornerRadius="10" Padding="10,7,10,9"
                    Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <CheckBox x:Name="StartupToggle" Content="Запускать с Windows" Style="{StaticResource Switch}" />
                    <DockPanel Margin="0,7,0,0">
                        <Button x:Name="ExitButton" DockPanel.Dock="Right" Content="Выход" Margin="6,0,0,0" />
                        <Button x:Name="ResetButton" Content="Сбросить до 100%" HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
